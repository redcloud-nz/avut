    "version": "0.7.22",
    "versionName": "Philomel"
  },
  "scripts": {
    "dev": "next dev --inspect",
    "dev-email": "email dev --dir 'src/emails' --port 3001",
    "prisma": "dotenv -e .env.local -- npx prisma",
    "build": "dotenv -e .env.local -- prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
