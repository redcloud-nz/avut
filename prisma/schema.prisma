// Schema for the AVUT Database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator dmmf {
  provider = "prisma-mock"
  output   = "../src/generated/dmmf.ts"
}

datasource db {
  provider = "postgresql"
}

// Authentication Models

model User {
  id                String                   @id
  name              String
  email             String
  emailVerified     Boolean                  @default(false)
  image             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  role              String?
  banned            Boolean?                 @default(false)
  banReason         String?
  banExpires        DateTime?
  sessions          Session[]                @relation("session_to_user")
  accounts          Account[]                @relation("account_to_user")
  organizationUsers OrganizationUser[]       @relation("organization_user_to_user")
  invitations       OrganizationInvitation[] @relation("organization_invitation_to_inviter")
  d4hAccessTokens   D4HAccessToken[]         @relation("d4h_access_token_to_user")

  authoredNotes          Note[]         @relation("note_to_author")
  formInstances          FormInstance[] @relation("form_instance_to_user")
  logEntries             LogEntry[]     @relation("log_entry_to_user")
  ownedLogEntries        LogEntry[]     @relation("log_entry_to_owner")
  impersonatedLogEntries LogEntry[]     @relation("log_entry_to_impersonator")
  logBatches             LogBatch[]     @relation("log_batch_to_user")

  @@unique([email])
  @@map("users")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation("session_to_user", fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeTeamId         String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("user_sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation("account_to_user", fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("user_acounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("user_verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String
  logo      String?
  createdAt DateTime
  metadata  String?

  configs     OrganizationConfig[]     @relation("organization_config_to_organization")
  invitations OrganizationInvitation[] @relation("organization_invitation_to_organization")
  teams       Team[]                   @relation("team_to_organization")
  users       OrganizationUser[]       @relation("organization_user_to_organization")
  d4h         Organization_D4H?        @relation("organization_d4h_to_organization")

  // Owned records
  logEntries                LogEntry[]                 @relation("log_entry_to_organization")
  notes                     Note[]                     @relation("note_to_organization")
  skillChecks               SkillCheck[]               @relation("skill_check_to_organization")
  skillCheckSessions        SkillCheckSession[]        @relation("skill_check_session_to_organization")
  skillPackages             SkillPackage[]             @relation("skill_package_to_organization")
  skillPackageSubscriptions SkillPackageSubscription[] @relation("skill_package_subscription_to_organization")
  personnel                 Person[]                   @relation("person_to_organization")
  d4hAccessTokens           D4HAccessToken[]           @relation("d4h_access_token_to_organization")
  teamMemberships           TeamMembership[]           @relation("team_membership_to_organization")

  i3IssuedItems I3IssuedItem[] @relation("i3_issued_item_to_organization")
  i3Templates   I3Template[]   @relation("i3_template_to_organization")
  formInstances FormInstance[] @relation("form_instance_to_organization")

  @@unique([slug])
  @@map("organizations")
}

model OrganizationConfig {
  organizationId String
  organization   Organization @relation("organization_config_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json

  @@unique([organizationId, key])
  @@map("organization_config")
}

model Team {
  id          String   @id
  name        String
  description String   @default("")
  tags        String[] @default([])
  properties  Json     @default("{}")

  organizationId  String
  organization    Organization     @relation("team_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  d4h             Team_D4H?        @relation("team_d4h_to_team")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt
  configs         TeamConfig[]     @relation("team_config_to_team")
  teamMemberships TeamMembership[] @relation("team_membership_to_team")

  @@index([organizationId])
  @@map("teams")
}

// The resolved D4H-organisation identity for an AVUT organisation, plus a cache of
// that org's D4H attributes. Distinct from `integrations.d4h` settings (policy);
// this is resolved foreign identity + fetched data. Created lazily on the first
// `linkTeamToD4H`. See docs/specs/d4h-linking.md §3.1.
model Organization_D4H {
  organizationId String
  organization   Organization @relation("organization_d4h_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)

  serverCode        String
  // Set → org-linked mode. null while the row exists → org-less-team mode (§5).
  d4hOrganisationId Int?

  // Cache of the D4H organisation's attributes (null in org-less-team mode).
  d4hOrganisationName    String?
  d4hTimezone            String?
  d4hCurrency            String?
  d4hReportingStartDay   Int?
  d4hReportingStartMonth Int?

  // The organisation access token a scheduled sync should use (Phase 2).
  syncTokenId String?
  syncToken   D4HAccessToken? @relation("organization_d4h_sync_token", fields: [syncTokenId], references: [id], onDelete: SetNull)

  // Pure sync bookkeeping — last refresh of the cached attributes above. Not a D4H value.
  lastSyncedAt DateTime?

  @@unique([organizationId])
  @@map("organization_d4h")
}

model Team_D4H {
  teamId String
  team   Team   @relation("team_d4h_to_team", fields: [teamId], references: [id], onDelete: Cascade)

  d4hTeamId         Int
  d4hTeamName       String
  d4hServerCode     String
  d4hOrganisationId Int?
  d4hTimezone       String?

  // Informational — the token that created the link.
  linkTokenId String?
  linkToken   D4HAccessToken? @relation("team_d4h_link_token", fields: [linkTokenId], references: [id], onDelete: SetNull)

  // Pure sync bookkeeping — set on every apply and on the first pull at link time.
  lastSyncedAt DateTime?

  @@unique([teamId])
  @@map("team_d4h")
}

model TeamConfig {
  teamId String
  team   Team   @relation("team_config_to_team", fields: [teamId], references: [id], onDelete: Cascade)
  key    String
  value  Json

  @@unique([teamId, key])
  @@map("team_config")
}

model OrganizationUser {
  id             String       @id
  organizationId String
  organization   Organization @relation("organization_user_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("organization_user_to_user", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  personId String? @unique
  person   Person? @relation("person_to_organization_user", fields: [personId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("organization_users")
}

model OrganizationInvitation {
  id             String       @id
  organizationId String
  organization   Organization @relation("organization_invitation_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  teamId         String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation("organization_invitation_to_inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  personId       String?      @unique
  person         Person?      @relation("organization_invitation_to_person", fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

// Logging Models
model LogEntry {
  id       String @id
  // Postgres-assigned write order. The canonical sort key for DISPLAYING a feed:
  // `timestamp` is transaction START time, so entries written by one $transaction
  // share a byte-identical timestamp and cannot be ordered by it.
  //
  // Not a commit order. A SERIAL is drawn at INSERT, so two concurrent transactions
  // can commit in the opposite order to their sequences, and a reader that has seen
  // max(sequence) = N can afterwards see a row < N appear. Safe for ordering a page
  // of results; NOT safe as a keyset-pagination or incremental-sync cursor without
  // an additional guard (e.g. a commit-order column, or a lag window).
  sequence Int    @default(autoincrement())

  // Owner. Exactly one of these is set, per `scope`; `system` sets neither.
  scope          String
  organizationId String?
  organization   Organization? @relation("log_entry_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?         @relation("log_entry_to_owner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Actor. `userId` is SetNull so a deleted user's actions elsewhere survive,
  // anonymised but still named by `actorLabel`.
  userId         String?
  user           User?     @relation("log_entry_to_user", fields: [userId], references: [id], onDelete: SetNull)
  actorLabel     String?
  impersonatorId String?
  impersonator   User?     @relation("log_entry_to_impersonator", fields: [impersonatorId], references: [id], onDelete: SetNull)
  batchId        String?
  batch          LogBatch? @relation("log_entry_to_batch", fields: [batchId], references: [id], onDelete: SetNull)

  action      String
  objectType  String
  objectId    String
  changes     Json     @default("[]")
  description String?
  timestamp   DateTime @default(now())

  objects LogEntryObject[] @relation("log_entry_object_to_log_entry")

  @@index([organizationId])
  @@index([objectType, objectId])
  @@index([scope, sequence])
  @@index([ownerId])
  @@index([batchId])
  @@index([sequence])
  @@map("log_entries")
}

// Fan-out index: which entities an entry is relevant to. Usually one row
// (`primary`, mirroring LogEntry.objectType/objectId), more when an entry
// bridges entities.
//
// A partial unique index — `ON "log_entry_objects" ("logEntryId") WHERE "role" =
// 'primary'` — allows AT MOST one primary row per entry; zero primary rows
// satisfies it too. "Exactly one" holds only because `recordLogEntry` always
// emits a primary row alongside the entry, in the same write. Prisma's DSL
// cannot express a partial unique index, so it is hand-added to the migration
// SQL and must be carried forward by hand if this table is ever recreated —
// copy it from the migration rather than from this comment.
model LogEntryObject {
  id         String   @id
  logEntryId String
  logEntry   LogEntry @relation("log_entry_object_to_log_entry", fields: [logEntryId], references: [id], onDelete: Cascade)
  objectType String
  objectId   String
  role       String

  @@index([objectType, objectId])
  @@index([logEntryId])
  @@map("log_entry_objects")
}

// One row per multi-entry operation run. `operationKey` says what kind of
// operation it was; `userId` says who set it off. Both are meaningful and
// orthogonal — a user-clicked sync and a nightly cron share a key and differ
// in initiator.
model LogBatch {
  id           String   @id
  operationKey String
  userId       String?
  user         User?    @relation("log_batch_to_user", fields: [userId], references: [id], onDelete: SetNull)
  actorLabel   String?
  description  String?
  startedAt    DateTime @default(now())

  entries LogEntry[] @relation("log_entry_to_batch")

  @@index([operationKey, startedAt])
  @@map("log_batches")
}

enum RecordStatus {
  Active
  Archived
  Deleted
}

model D4HAccessToken {
  id             String        @id
  organizationId String?
  organization   Organization? @relation("d4h_access_token_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation("d4h_access_token_to_user", fields: [userId], references: [id], onDelete: Cascade)
  label          String
  token          String
  serverCode     String
  status         String
  expiresAt      DateTime
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  linkedTeams          Team_D4H[]         @relation("team_d4h_link_token")
  syncingOrganizations Organization_D4H[] @relation("organization_d4h_sync_token")

  @@index([organizationId])
  @@map("d4h_access_tokens")
}

model Person {
  id             String       @id
  organizationId String
  organization   Organization @relation("person_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  email      String
  tags       String[]     @default([])
  properties Json         @default("{}")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  status     RecordStatus @default(Active)

  issuedItems                  I3IssuedItem[]          @relation("i3_issued_item_to_person")
  organizationInvitation       OrganizationInvitation? @relation("organization_invitation_to_person")
  organizationUser             OrganizationUser?       @relation("person_to_organization_user")
  skillChecksAsAssessee        SkillCheck[]            @relation("skill_check_assessee")
  skillChecksAsAssessor        SkillCheck[]            @relation("skill_check_assessor")
  skillCheckSessionsAsAssessee SkillCheckSession[]     @relation("skill_check_session_assessees")
  skillCheckSessionsAsAssessor SkillCheckSession[]     @relation("skill_check_session_assessors")
  teamMemberships              TeamMembership[]        @relation("team_membership_to_person")

  @@unique([organizationId, email]) // Only one person per email address in an organization
  @@index([organizationId])
  @@map("personnel")
}

model TeamMembership {
  id             String       @id
  organizationId String
  organization   Organization @relation("team_membership_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team         @relation("team_membership_to_team", fields: [teamId], references: [id], onDelete: Cascade)
  personId       String
  person         Person       @relation("team_membership_to_person", fields: [personId], references: [id], onDelete: Cascade)
  tags           String[]     @default([])
  properties     Json         @default("{}")
  status         RecordStatus @default(Active)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  d4h TeamMembership_D4H? @relation("team_membership_d4h_to_team_membership")

  @@unique([teamId, personId])
  @@index([teamId])
  @@index([personId])
  @@index([teamId, status])
  @@map("team_memberships")
}

// Presence of this row marks a membership as D4H-managed. Memberships without it
// were added manually and are never touched by sync. See docs/specs/d4h-linking.md §3.3.
model TeamMembership_D4H {
  teamMembershipId String
  teamMembership   TeamMembership @relation("team_membership_d4h_to_team_membership", fields: [teamMembershipId], references: [id], onDelete: Cascade)

  d4hMemberId Int
  // Raw D4H value: OPERATIONAL / NON_OPERATIONAL / OBSERVER / RETIRED.
  d4hStatus   String
  d4hPosition String?
  d4hRef      String?
  d4hRoleId   Int?

  @@unique([teamMembershipId])
  @@index([d4hMemberId])
  @@map("team_membership_d4h")
}

// Notes models

model Note {
  id             String        @id
  organizationId String?
  organization   Organization? @relation("note_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User          @relation("note_to_author", fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  tags           String[]      @default([])
  properties     Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([authorId])
  @@map("notes")
}

// Skill tracking models

model SkillPackage {
  id             String       @id
  organizationId String
  organization   Organization @relation("skill_package_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String
  tags           String[]     @default([])
  properties     Json         @default("{}")
  published      Boolean      @default(false)
  status         RecordStatus @default(Active)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  groups        SkillGroup[]               @relation("skill_group_to_skill_package")
  skills        Skill[]                    @relation("skill_to_skill_package")
  subscriptions SkillPackageSubscription[] @relation("skill_package_subscription_to_skill_package")

  @@index([organizationId])
  @@map("skill_packages")
}

model SkillGroup {
  id             String       @id
  skillPackageId String
  skillPackage   SkillPackage @relation("skill_group_to_skill_package", fields: [skillPackageId], references: [id], onDelete: Cascade)
  name           String
  description    String
  tags           String[]     @default([])
  properties     Json         @default("{}")
  sequence       Int          @default(0)
  defaultInclude Boolean      @default(true)
  status         RecordStatus @default(Active)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  skills                Skill[]              @relation("skill_to_skill_group")
  subscriptionOverrides SkillGroupOverride[] @relation("skill_group_override_to_skill_group")

  @@index([skillPackageId])
  @@map("skill_groups")
}

model Skill {
  id              String       @id
  skillPackageId  String
  skillPackage    SkillPackage @relation("skill_to_skill_package", fields: [skillPackageId], references: [id], onDelete: Cascade)
  skillGroupId    String
  skillGroup      SkillGroup   @relation("skill_to_skill_group", fields: [skillGroupId], references: [id], onDelete: Cascade)
  name            String
  description     String
  tags            String[]     @default([])
  properties      Json         @default("{}")
  sequence        Int          @default(0)
  frequency       Int          @default(12) // revalidation frequency in months
  defaultInclude  Boolean      @default(true)
  defaultRequired Boolean      @default(false)
  status          RecordStatus @default(Active)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  checks                SkillCheck[]        @relation("skill_check_to_skill")
  sessions              SkillCheckSession[] @relation("skill_check_session_skills")
  subscriptionOverrides SkillOverride[]     @relation("skill_override_to_skill")

  @@index([skillPackageId])
  @@map("skills")
}

enum SkillCheckStatus {
  Draft
  Include
  Exclude
}

enum SkillCheckResult {
  NotTaught
  LowFail
  Fail
  HighFail
  WeakPass
  Pass
  StrongPass
  Exempt
  Expired
  Provisional
}

model SkillCheckSession {
  id             String           @id
  organizationId String
  organization   Organization     @relation("skill_check_session_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  assessees      Person[]         @relation("skill_check_session_assessees")
  assessors      Person[]         @relation("skill_check_session_assessors")
  skills         Skill[]          @relation("skill_check_session_skills")
  name           String
  sessionNumber  Int
  startsAt       DateTime?
  endsAt         DateTime?
  notes          String?
  status         SkillCheckStatus @default(Draft)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  skillChecks SkillCheck[] @relation("skill_check_session_checks")

  @@unique([organizationId, sessionNumber])
  @@index([organizationId])
  @@map("skill_check_sessions")
}

model SkillCheck {
  id             String             @id
  organizationId String
  organization   Organization       @relation("skill_check_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  assesseeId     String
  sessionId      String?
  session        SkillCheckSession? @relation("skill_check_session_checks", fields: [sessionId], references: [id], onDelete: SetNull)
  assessee       Person             @relation("skill_check_assessee", fields: [assesseeId], references: [id], onDelete: Cascade)
  assessorId     String
  assessor       Person             @relation("skill_check_assessor", fields: [assessorId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill              @relation("skill_check_to_skill", fields: [skillId], references: [id], onDelete: Cascade)
  result         SkillCheckResult
  notes          String
  status         SkillCheckStatus   @default(Draft)
  createdAt      DateTime           @default(now())

  @@unique([assesseeId, assessorId, sessionId, skillId])
  @@index([organizationId])
  @@index([assesseeId])
  @@index([assessorId])
  @@index([sessionId])
  @@index([skillId])
  @@map("skill_checks")
}

model SkillPackageSubscription {
  id             String       @id
  organizationId String
  organization   Organization @relation("skill_package_subscription_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  skillPackageId String
  skillPackage   SkillPackage @relation("skill_package_subscription_to_skill_package", fields: [skillPackageId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  groupOverrides SkillGroupOverride[] @relation("skill_group_override_to_skill_package_subscription")
  skillOverrides SkillOverride[]      @relation("skill_override_to_skill_package_subscription")

  @@unique([organizationId, skillPackageId])
  @@index([organizationId])
  @@index([skillPackageId])
  @@map("skill_package_subscriptions")
}

model SkillGroupOverride {
  subscriptionId String
  subscription   SkillPackageSubscription @relation("skill_group_override_to_skill_package_subscription", fields: [subscriptionId], references: [id], onDelete: Cascade)
  skillGroupId   String
  skillGroup     SkillGroup               @relation("skill_group_override_to_skill_group", fields: [skillGroupId], references: [id], onDelete: Cascade)
  description    String?
  include        Boolean

  @@unique([subscriptionId, skillGroupId])
  @@index([subscriptionId])
  @@index([skillGroupId])
  @@map("skill_group_overrides")
}

model SkillOverride {
  subscriptionId String
  subscription   SkillPackageSubscription @relation("skill_override_to_skill_package_subscription", fields: [subscriptionId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill                    @relation("skill_override_to_skill", fields: [skillId], references: [id], onDelete: Cascade)
  description    String?
  frequency      Int?
  include        Boolean

  @@unique([subscriptionId, skillId])
  @@index([subscriptionId])
  @@index([skillId])
  @@map("skill_overrides")
}

model I3IssuedItem {
  id             String       @id
  organizationId String
  organization   Organization @relation("i3_issued_item_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  personId       String
  person         Person       @relation("i3_issued_item_to_person", fields: [personId], references: [id], onDelete: Cascade)
  name           String
  description    String
  properties     Json         @default("{}")
  status         RecordStatus @default(Active)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([personId])
  @@map("i3_issued_items")
}

model I3Template {
  id             String       @id
  organizationId String
  organization   Organization @relation("i3_template_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String

  status    RecordStatus @default(Active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  d4h      I3Template_D4H?     @relation("i3_template_d4h_to_i3_template")
  variants I3TemplateVariant[] @relation("i3_template_variant_to_i3_template")

  @@index([organizationId])
  @@map("i3_templates")
}

model I3Template_D4H {
  templateId String
  template   I3Template @relation("i3_template_d4h_to_i3_template", fields: [templateId], references: [id], onDelete: Cascade)

  categoryId    Int
  categoryTitle String
  kindId        Int
  kindTitle     String

  outputRefFormat String
  requireSN       Boolean

  @@unique([templateId])
  @@map("i3_template_d4h")
}

model I3TemplateVariant {
  id         String     @id
  templateId String
  template   I3Template @relation("i3_template_variant_to_i3_template", fields: [templateId], references: [id], onDelete: Cascade)
  name       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  d4h I3TemplateVariant_D4H? @relation("i3_template_variant_d4h_to_i3_template_variant")

  @@index([templateId])
  @@map("i3_template_variants")
}

model I3TemplateVariant_D4H {
  variantId String
  variant   I3TemplateVariant @relation("i3_template_variant_d4h_to_i3_template_variant", fields: [variantId], references: [id], onDelete: Cascade)

  brandId    Int
  brandTitle String
  modelId    Int
  modelTitle String

  @@unique([variantId])
  @@map("i3_template_variant_d4h")
}

model FormInstance {
  id             String       @id
  formKey        String
  organizationId String
  organization   Organization @relation("form_instance_to_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation("form_instance_to_user", fields: [userId], references: [id], onDelete: SetNull)

  formData   Json   @default("{}")
  formStatus String @default("Draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FormInstanceItem[] @relation("form_instance_item_to_form_instance")

  @@index([formKey, organizationId, userId])
  @@map("form_instances")
}

model FormInstanceItem {
  id             String       @id
  formInstanceId String
  formInstance   FormInstance @relation("form_instance_item_to_form_instance", fields: [formInstanceId], references: [id], onDelete: Cascade)

  parentItemId String?
  parentItem   FormInstanceItem? @relation("form_instance_item_to_parent_item", fields: [parentItemId], references: [id], onDelete: Cascade)

  collectionKey String
  formData      Json   @default("{}")

  children FormInstanceItem[] @relation("form_instance_item_to_parent_item")

  @@index([formInstanceId])
  @@map("form_instance_items")
}
