{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "integration": true,
      "production": true,
      "preview/**": true
    }
  },
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/cron/purge-rubbish",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/cleanup-batch-update-plans",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/d4h-nag",
      "schedule": "0 * * * *"
    }
  ]
}
